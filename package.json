{
  "name": "cortexdb-e2e",
  "version": "0.2.0-beta.1",
  "private": true,
  "scripts": {
    "dashboard:build": "python3 scripts/dashboard_build.py",
    "dashboard:check": "python3 scripts/dashboard_build.py --check",
    "dashboard:standalone-check": "python3 scripts/dashboard_build.py --check",
    "dashboard:standalone-smoke": "python3 scripts/dashboard_dist_smoke.py",
    "dashboard:release-check": "python3 scripts/dashboard_release.py --self-test && make dashboard-package dashboard-validate-package",
    "dashboard:smoke": "playwright test e2e/dashboard.spec.ts e2e/dashboard_auth.spec.ts",
    "dashboard:screenshots": "node e2e/dashboard_screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
