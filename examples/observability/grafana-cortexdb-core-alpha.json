{
  "uid": "cortexdb-core-alpha",
  "title": "CortexDB Core Alpha",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["cortexdb", "core-alpha"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Commit vs Checkpoint",
      "type": "timeseries",
      "targets": [
        { "expr": "cortexdb_current_seq", "legendFormat": "current_seq" },
        { "expr": "cortexdb_checkpoint_seq", "legendFormat": "checkpoint_seq" }
      ]
    },
    {
      "id": 2,
      "title": "WAL Size",
      "type": "timeseries",
      "targets": [
        { "expr": "cortexdb_wal_size_bytes", "legendFormat": "wal_size_bytes" }
      ]
    },
    {
      "id": 3,
      "title": "WAL Write Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(cortexdb_wal_writer_records[5m])", "legendFormat": "records/sec" },
        { "expr": "rate(cortexdb_wal_writer_bytes[5m])", "legendFormat": "bytes/sec" }
      ]
    },
    {
      "id": 4,
      "title": "Segments",
      "type": "timeseries",
      "targets": [
        { "expr": "cortexdb_live_segments", "legendFormat": "live" },
        { "expr": "cortexdb_retired_segments", "legendFormat": "retired" }
      ]
    },
    {
      "id": 5,
      "title": "ANN Graph",
      "type": "timeseries",
      "targets": [
        { "expr": "cortexdb_ann_graph_nodes", "legendFormat": "nodes" },
        { "expr": "cortexdb_ann_total_edges", "legendFormat": "edges" }
      ]
    },
    {
      "id": 6,
      "title": "Actor Queue Pressure",
      "type": "timeseries",
      "targets": [
        { "expr": "cortexdb_actor_queue_depth", "legendFormat": "queue_depth" },
        { "expr": "cortexdb_actor_queue_capacity", "legendFormat": "queue_capacity" }
      ]
    },
    {
      "id": 7,
      "title": "ANN Fallback Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(cortexdb_ann_fallbacks[5m]) / clamp_min(increase(cortexdb_ann_search_requests[5m]), 1)",
          "legendFormat": "fallback_rate"
        }
      ]
    },
    {
      "id": 8,
      "title": "ANN No-fallback Decisions",
      "type": "timeseries",
      "targets": [
        { "expr": "increase(cortexdb_ann_no_fallback_allowed[5m])", "legendFormat": "allowed" },
        { "expr": "increase(cortexdb_ann_no_fallback_blocked[5m])", "legendFormat": "blocked" }
      ]
    },
    {
      "id": 9,
      "title": "ANN Search p99 Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(cortexdb_ann_search_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99_ms"
        }
      ]
    },
    {
      "id": 10,
      "title": "Validation Failures",
      "type": "timeseries",
      "targets": [
        { "expr": "increase(cortexdb_validation_failures[5m])", "legendFormat": "validation_failures" }
      ]
    }
  ]
}
