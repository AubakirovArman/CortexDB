<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cortexdb.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cortex-server</string>
        <string>/var/lib/cortexdb</string>
        <string>127.0.0.1:8181</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/cortexdb/server.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/cortexdb/server.error.log</string>
</dict>
</plist>
