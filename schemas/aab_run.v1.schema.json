{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cortexdb.aab_run.v1",
  "title": "CortexDB AAB-mini run v1",
  "description": "Frozen contract for an anti-absorption AAB-mini scoring run (F4.1). Every system carries per-axis RANKED/UNRANKED verdicts on the six axes; structural axes may be UNRANKED (never silently zero).",
  "type": "object",
  "required": ["schema_version", "systems"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["cortexdb.aab_mini.v1"] },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "axes", "ranked_axes", "unranked_axes"],
        "properties": {
          "system": { "type": "string" },
          "ranked_axes": { "type": "integer", "minimum": 0, "maximum": 6 },
          "unranked_axes": { "type": "array", "items": { "type": "string" } },
          "axes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["rank"],
              "properties": { "rank": { "type": "string", "enum": ["RANKED", "UNRANKED"] } }
            }
          }
        }
      }
    }
  }
}
