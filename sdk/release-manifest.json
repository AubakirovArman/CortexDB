{
  "schema_version": 1,
  "workspace_version_source": "Cargo.toml",
  "api_version_source": "docs/openapi.yaml",
  "changelog": "CHANGELOG.md",
  "version_policy": {
    "package_versions_must_match_workspace": true,
    "python_prerelease_uses_pep440_spelling": true,
    "openapi_version_must_start_with_workspace_version": true,
    "tag_must_match_workspace_version": true
  },
  "deprecation_policy": {
    "document": "docs/archive/SDK_DEPRECATION_POLICY.md",
    "deprecated_openapi_entries_must_be_listed": true,
    "sdk_clients_must_not_use_deprecated_routes": true,
    "breaking_changes_require_changelog": true
  },
  "packages": [
    {
      "language": "rust_api_types",
      "name": "cortex-api-types",
      "manifest": "crates/cortex-api-types/Cargo.toml",
      "registry": "crates.io",
      "publish_command": "cargo publish -p cortex-api-types",
      "dry_run_command": "cargo publish -p cortex-api-types --dry-run"
    },
    {
      "language": "rust",
      "name": "cortex-sdk",
      "manifest": "crates/cortex-sdk/Cargo.toml",
      "registry": "crates.io",
      "publish_command": "cargo publish -p cortex-sdk",
      "dry_run_command": "cargo publish -p cortex-sdk --dry-run"
    },
    {
      "language": "python",
      "name": "cortexdb-client",
      "manifest": "sdk/python/pyproject.toml",
      "registry": "pypi",
      "publish_command": "pypa/gh-action-pypi-publish",
      "dry_run_command": "python -m build sdk/python --wheel"
    },
    {
      "language": "typescript",
      "name": "@cortexdb/client",
      "manifest": "sdk/typescript/package.json",
      "registry": "npm",
      "publish_command": "npm publish --access public --provenance",
      "dry_run_command": "npm pack --dry-run"
    }
  ],
  "release_workflow": ".github/workflows/sdk-release.yml",
  "release_artifacts": {
    "sdk_examples_archive": "target/sdk-release-artifacts/cortexdb-sdk-examples-${version}.tar.gz",
    "sdk_examples": [
      "sdk/README.md",
      "sdk/release-manifest.json",
      "sdk/python/README.md",
      "sdk/python/examples/basic.py",
      "sdk/typescript/README.md",
      "sdk/typescript/examples/basic.mjs",
      "crates/cortex-sdk/examples/basic.rs",
      "crates/cortex-sdk/examples/live_contract.rs",
      "docs/SDK_QUICKSTART.md",
      "docs/archive/SDK_RELEASE.md",
      "docs/archive/SDK_PUBLICATION_STATUS.md",
      "docs/archive/SDK_DEPRECATION_POLICY.md"
    ]
  },
  "required_gates": [
    "make sdk-check",
    "make sdk-contract-check",
    "make sdk-e2e-release-check",
    "make sdk-release-artifacts-check",
    "make openapi-contract-check"
  ],
  "publish_policy": {
    "manual_only": true,
    "requires_tag_ref": true,
    "tag_prefix": "v",
    "requires_explicit_publish_input": true,
    "environment": "sdk-release"
  },
  "registry_gate": {
    "command": "make sdk-registry-gate-check",
    "report": "target/sdk-registry-gate/report.json",
    "requires_manual_approval": true,
    "requires_registry_credentials": [
      "PyPI trusted publishing",
      "NPM_TOKEN",
      "CARGO_REGISTRY_TOKEN"
    ],
    "does_not_claim_publication_without_release_job": true
  }
}
