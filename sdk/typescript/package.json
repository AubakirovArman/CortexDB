{
  "name": "@cortexdb/client",
  "version": "0.2.0-beta.1",
  "description": "Beta CortexDB HTTP client",
  "type": "module",
  "main": "./cortexdb-client.cjs",
  "module": "./cortexdb-client.js",
  "types": "./cortexdb-client.d.ts",
  "scripts": {
    "test": "node --test test.js",
    "build": "esbuild cortexdb-client.ts --outfile=cortexdb-client.js --format=esm --target=es2022 && esbuild cortexdb-client.ts --outfile=cortexdb-client.cjs --format=cjs --target=node18"
  },
  "exports": {
    ".": {
      "types": "./cortexdb-client.d.ts",
      "import": "./cortexdb-client.js",
      "require": "./cortexdb-client.cjs"
    }
  },
  "files": [
    "cortexdb-client.d.ts",
    "cortexdb-client.js",
    "cortexdb-client.cjs",
    "cortexdb-client.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AubakirovArman/CortexDB.git"
  },
  "bugs": {
    "url": "https://github.com/AubakirovArman/CortexDB/issues"
  },
  "homepage": "https://github.com/AubakirovArman/CortexDB#readme",
  "sideEffects": false,
  "license": "MIT"
}
